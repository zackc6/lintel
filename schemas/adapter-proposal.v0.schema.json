{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackc6/lintel/schemas/adapter-proposal.v0.schema.json",
  "title": "Lintel adapter proposal v0 (Choreo Kernel AST)",
  "description": "Year-1 data-plane payload for propose. Choreo Kernel JSON. Not Cake IR. Not Triton source. Triton schedule knobs are degenerate (examples/later).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapter_id", "kernel"],
  "properties": {
    "schema": { "const": "lintel.adapter_proposal.v0" },
    "adapter_id": {
      "type": "string",
      "description": "Year-1 live: choreo.v0. Degenerate: triton.v0 schedule knobs. Later: tile.v0, hip.v0, cake.v0, …"
    },
    "graph_hash": { "type": "string" },
    "hw_id": { "type": "string" },
    "compiler_ver": {
      "type": "string",
      "description": "Pin choreoir and the device sink, e.g. choreoir==0.1.0;triton==3.3.0+cu128"
    },
    "enum_id": {
      "type": "string",
      "description": "Allowlist slot. Opaque field-strings are degenerate."
    },
    "kernel": { "$ref": "#/$defs/kernel" },
    "gates": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["W", "L", "S", "V", "compile_ok"]
      }
    },
    "reject": {
      "type": "object",
      "description": "Present only when adapter_gate fails. Control IR copies {where, hint} onto the CFG edge.",
      "additionalProperties": false,
      "required": ["ok", "where"],
      "properties": {
        "ok": { "const": false },
        "where": {
          "type": "string",
          "enum": ["W", "L", "S", "V", "compile_ok"]
        },
        "hint": { "type": "string" },
        "reason": { "type": "string" },
        "finding": { "$ref": "#/$defs/finding" }
      }
    }
  },
  "$defs": {
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "stride"],
      "properties": {
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "stride": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "severity", "node", "msg"],
      "properties": {
        "gate": { "type": "string", "enum": ["W", "L", "S", "V"] },
        "severity": { "type": "string", "enum": ["error", "warning"] },
        "node": { "type": "string" },
        "msg": { "type": "string" },
        "partition": { "type": ["string", "null"] },
        "thread": { "type": ["integer", "null"] },
        "element": {
          "type": ["array", "null"],
          "items": { "type": "integer" }
        }
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "buffers", "partitions", "body"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "dtype", "shape"],
            "properties": {
              "name": { "type": "string" },
              "dtype": { "type": "string", "enum": ["f16", "bf16", "f32", "f8"] },
              "shape": {
                "type": "array",
                "items": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "buffers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "space", "layout", "dtype"],
            "properties": {
              "name": { "type": "string" },
              "space": { "type": "string", "enum": ["gmem", "smem", "tmem", "regs"] },
              "dtype": { "type": "string", "enum": ["f16", "bf16", "f32", "f8"] },
              "layout": { "$ref": "#/$defs/layout" }
            }
          }
        },
        "partitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role", "width"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string", "enum": ["load", "math", "store", "generic"] },
              "width": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "body": {
          "type": "array",
          "items": { "$ref": "#/$defs/op" }
        },
        "attrs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "op": {
      "type": "object",
      "required": ["op", "id"],
      "properties": {
        "op": { "type": "string", "enum": ["Copy", "Mma", "Barrier", "Pipeline"] },
        "id": { "type": "string" },
        "src": { "type": "string" },
        "dst": { "type": "string" },
        "partition": { "type": "string" },
        "a": { "type": "string" },
        "b": { "type": "string" },
        "c": { "type": "string" },
        "wait_for": {
          "type": "array",
          "items": { "type": "string" }
        },
        "arrive": { "type": "string" },
        "depth": { "type": "integer", "minimum": 1 },
        "body": {
          "type": "array",
          "items": { "$ref": "#/$defs/op" }
        }
      }
    }
  }
}
