{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackc6/lintel/schemas/lintel-ir.poc.schema.json",
  "title": "LintelIRPoC",
  "description": "PoC control-plane IR: CFG + cost + compile-to-ADG. Terminators land | revert | reject. Not kernel text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module_id", "region", "pins", "plan"],
  "properties": {
    "schema_version": { "const": "lintel-ir.poc" },
    "module_id": { "type": "string", "minLength": 1 },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "graph_hash", "op_family"],
      "properties": {
        "region_id": { "type": "string", "minLength": 1 },
        "graph_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "op_family": { "type": "string", "enum": ["attention", "gemm", "other"] }
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hw_id", "compiler_ver", "adapter_id", "policy_id"],
      "properties": {
        "hw_id": { "type": "string", "minLength": 1 },
        "compiler_ver": { "type": "string", "minLength": 1 },
        "adapter_id": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string" },
        "policy_id": { "type": "string", "minLength": 1 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "entry", "blocks"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    }
  },
  "$defs": {
    "op": {
      "type": "object",
      "required": ["op", "id"],
      "properties": {
        "op": {
          "type": "string",
          "enum": ["cache_key", "triage", "propose", "gate", "cost", "measure", "fitness"]
        },
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "enum_id": { "type": "string" },
        "oracle": { "type": "string" },
        "on": { "type": "string" },
        "owner": { "type": "string" },
        "detail": { "type": "string" },
        "F": { "type": "string" },
        "budget_usd": { "type": "number" }
      }
    },
    "term": {
      "type": "object",
      "required": ["op", "cache_key"],
      "properties": {
        "op": { "type": "string", "enum": ["land", "revert", "reject"] },
        "cache_key": { "type": "string" },
        "proposal": { "type": "string" },
        "fitness": { "type": "string" },
        "or_else": { "type": "string", "enum": ["last_good", "classical"] },
        "target": { "type": "string", "enum": ["last_good", "classical"] },
        "where": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "cond": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pred", "then", "else"],
      "properties": {
        "pred": { "type": "string", "minLength": 1 },
        "then": { "type": "string", "minLength": 1 },
        "else": { "type": "string", "minLength": 1 },
        "where": { "type": "string" },
        "seam": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ops"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ops": { "type": "array", "items": { "$ref": "#/$defs/op" } },
        "cond": { "$ref": "#/$defs/cond" },
        "term": { "$ref": "#/$defs/term" }
      },
      "oneOf": [
        { "required": ["cond"], "not": { "required": ["term"] } },
        { "required": ["term"], "not": { "required": ["cond"] } }
      ]
    }
  }
}
