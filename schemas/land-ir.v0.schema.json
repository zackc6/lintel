{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackc6/lintel/schemas/land-ir.v0.schema.json",
  "title": "LintelLandIR",
  "description": "Control-plane program. Terminators are land | revert | reject. Does not encode kernel text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module_id", "region", "pins", "plan"],
  "properties": {
    "schema_version": { "const": "land-ir.v0" },
    "module_id": { "type": "string", "minLength": 1 },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "graph_hash", "op_family"],
      "properties": {
        "region_id": { "type": "string", "minLength": 1 },
        "graph_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "op_family": { "type": "string", "enum": ["attention", "gemm", "other"] }
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hw_id", "compiler_ver", "adapter_id", "policy_id"],
      "properties": {
        "hw_id": { "type": "string", "minLength": 1 },
        "compiler_ver": { "type": "string", "minLength": 1 },
        "adapter_id": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string" },
        "policy_id": { "type": "string", "minLength": 1 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "ops", "term"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "ops": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["op", "id"],
            "properties": {
              "op": {
                "type": "string",
                "enum": ["cache_key", "triage", "propose", "gate", "measure", "fitness"]
              },
              "id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string" },
              "enum_id": { "type": "string" },
              "oracle": { "type": "string" },
              "on": { "type": "string" },
              "owner": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        },
        "term": {
          "type": "object",
          "required": ["op", "cache_key"],
          "properties": {
            "op": { "type": "string", "enum": ["land", "revert", "reject"] },
            "cache_key": { "type": "string" },
            "proposal": { "type": "string" },
            "fitness": { "type": "string" },
            "or_else": { "type": "string", "enum": ["last_good", "classical"] },
            "target": { "type": "string", "enum": ["last_good", "classical"] },
            "where": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      }
    }
  }
}
