{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackc6/lintel/schemas/admit-record.v0.schema.json",
  "title": "LintelAdmitRecord",
  "description": "Versioned, customer-owned contract for one specialize attempt. If it is not in this record, it did not happen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "created_at",
    "region",
    "pins",
    "actions",
    "oracles",
    "cache_key",
    "cache_key_digest",
    "artifact",
    "fitness",
    "decision",
    "fallback"
  ],
  "properties": {
    "schema_version": { "const": "admit-record.v0" },
    "record_id": { "type": "string", "minLength": 1 },
    "prev_hash": {
      "type": ["string", "null"],
      "description": "SHA-256 of the previous admit record in this session, or null for genesis."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "commentary": {
      "type": "string",
      "description": "Optional natural language. Never the source of truth."
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "graph_hash", "op_family"],
      "properties": {
        "region_id": { "type": "string", "minLength": 1 },
        "graph_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "op_family": { "type": "string", "enum": ["attention", "gemm", "other"] }
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hw_id", "compiler_ver", "adapter_id", "model_id", "policy_id"],
      "properties": {
        "hw_id": { "type": "string", "minLength": 1 },
        "compiler_ver": { "type": "string", "minLength": 1 },
        "adapter_id": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "policy_id": { "type": "string", "minLength": 1 }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "enum_id"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["propose_schedule", "propose_hint", "propose_acf", "noop"]
          },
          "enum_id": {
            "type": "string",
            "minLength": 1,
            "description": "Must be in the adapter's enumerated action space. Not free text."
          }
        }
      }
    },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "result", "false_neg_owner"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "enum": ["pass", "fail", "skip"] },
          "false_neg_owner": {
            "type": "string",
            "minLength": 1,
            "description": "Named human or team that owns a miss. Empty string is illegal."
          },
          "detail": { "type": "string" }
        }
      }
    },
    "cache_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "graph_hash", "hw_id", "compiler_ver", "adapter_id", "policy_id"],
      "properties": {
        "schema_version": { "const": "cache-key.v0" },
        "graph_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "hw_id": { "type": "string", "minLength": 1 },
        "compiler_ver": { "type": "string", "minLength": 1 },
        "adapter_id": { "type": "string", "minLength": 1 },
        "policy_id": { "type": "string", "minLength": 1 }
      }
    },
    "cache_key_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256 of canonical JSON of cache_key (sorted keys). Serve is lookup(this)."
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "kind"],
      "properties": {
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "kind": {
          "type": "string",
          "enum": ["triton_kernel", "acf", "schedule_ir", "none"]
        },
        "uri": { "type": "string" }
      }
    },
    "fitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["F_name", "traces", "usd_per_compile"],
      "properties": {
        "F_name": { "type": "string", "minLength": 1 },
        "baseline": { "type": "number" },
        "delta": { "type": "number" },
        "usd_per_compile": { "type": "number", "minimum": 0 },
        "traces": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decision": { "type": "string", "enum": ["freeze", "fallback", "reject"] },
    "fallback": { "type": "string", "enum": ["last_good", "classical", "none"] }
  }
}
