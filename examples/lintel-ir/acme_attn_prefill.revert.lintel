// Same %k as acme_attn_prefill.lintel.
// serving_ab fails parity → terminator is revert, not land.
// Lowers to examples/admit-record.fallback.json

module @rec_acme_attn_prefill_015 version "lintel-ir.v0" {

  region @attn_prefill {
    region_id = "attn.prefill.qkv"
    graph     = sha256:bbcd57f9162e8a42bbf26df28a6b2a3ac2f8793061c036e198afeaf4f65d6db0
    op_family = attention
  }

  pins {
    hw       = "nvidia.b200.80gb"
    compiler = "choreoir==0.1.0;triton==3.3.0+cu128"
    adapter  = @choreo.v0
    model    = "vendor.frontier.2026-10-20"
    policy   = @lintel.specialize.v0
  }

  plan @specialize {
  ^entry:
    %k  = cache_key @attn_prefill, pins
    %r  = triage @attn_prefill
    %p  = propose propose_kernel "choreo.attn.d2.w8"
    %g0 = gate golden     %p owner @kernels.acme
    %g1 = gate numerical  %p owner @kernels.acme { max_abs_err = 1e-3 }
    %g2 = gate serving_ab %p owner @serving.acme
      // fail { seam = serving, where = serving.output_parity,
      //        reason = "3/1000 decode mismatch" }
    revert last_good under %k
  }
}
